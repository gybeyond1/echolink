<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      NotifySync 主题：Telegram Day 浅色风格（已移除深浅色切换，统一浅色）
      parent 用 MaterialComponents.Light，固定浅色，不再随系统/手动切换。
      颜色全部引用 @color（values/ 中定义）。
    -->
    <style name="Theme.NotifySync" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorControlNormal">@color/on_surface_variant</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- 状态栏/导航栏透明：让全局壁纸（含顶栏）成为统一整体，文字用浅色背景上的深图标 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- 弹窗（菜单/创建话题/发现/添加好友等）统一为聊天页浅色材质 + 周围遮罩 -->
        <item name="alertDialogTheme">@style/Theme.NotifySync.Dialog</item>
        <item name="dialogTheme">@style/Theme.NotifySync.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.NotifySync.Dialog</item>
    </style>

    <!-- 所有 AlertDialog 统一：与聊天页面背景同色 + 品牌蓝强调 + 0.5 半透明遮罩区分层级 -->
    <style name="Theme.NotifySync.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <!-- Material AlertDialog 背景由 colorSurface 决定，必须设为 chat_bg，不能只改 windowBackground -->
        <item name="colorSurface">@color/chat_bg</item>
        <item name="colorSurfaceVariant">@color/chat_bg</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@color/chat_bg</item>
        <item name="android:background">@color/chat_bg</item>
        <item name="android:colorBackground">@color/chat_bg</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:windowIsFloating">true</item>
    </style>
</resources>
