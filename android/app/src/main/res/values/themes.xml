<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
      EchoLink 主题：新拟态（Neumorphism），亮/暗双主题。
      parent 用 MaterialComponents.DayNight，跟随系统暗色；
      颜色全部引用 @color（values / values-night 中定义，自动切换）。
    -->
    <style name="Theme.EchoLink" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorPrimaryVariant">@color/brand_primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="colorError">@color/error</item>
        <item name="android:colorBackground">@color/background</item>
        <item name="colorOnBackground">@color/on_surface</item>
        <item name="colorControlNormal">@color/on_surface_variant</item>
        <item name="colorControlActivated">@color/brand_primary</item>
        <item name="android:windowBackground">@color/background</item>
        <!-- 状态栏/导航栏透明：让整页新拟态基底成为统一整体 -->
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
        <!-- 弹窗（菜单/创建话题/发现/添加好友等）统一为新拟态基底 + 品牌蓝强调 -->
        <item name="alertDialogTheme">@style/Theme.EchoLink.Dialog</item>
        <item name="dialogTheme">@style/Theme.EchoLink.Dialog</item>
        <item name="materialAlertDialogTheme">@style/Theme.EchoLink.Dialog</item>
    </style>

    <!-- 所有 AlertDialog 统一：与新拟态基底同色 + 品牌蓝强调 -->
    <style name="Theme.EchoLink.Dialog" parent="ThemeOverlay.MaterialComponents.Dialog.Alert">
        <item name="colorSurface">@color/chat_bg</item>
        <item name="colorSurfaceVariant">@color/chat_bg</item>
        <item name="colorOnSurface">@color/on_surface</item>
        <item name="android:windowBackground">@color/chat_bg</item>
        <item name="android:background">@color/chat_bg</item>
        <item name="android:colorBackground">@color/chat_bg</item>
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/on_primary</item>
        <item name="android:textColorPrimary">@color/on_surface</item>
        <item name="android:textColor">@color/on_surface</item>
        <item name="android:windowIsFloating">true</item>
    </style>

    <!-- 侧滑栏菜单项文字：放大到 18sp -->
    <style name="NavDrawerText" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textSize">18sp</item>
    </style>
</resources>
