<?xml version="1.0" encoding="utf-8"?>
<!-- Telegram 风格聊天背景：渐变 + 微妙图案 -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 底层渐变 -->
    <item>
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#E6EBEE"
                android:endColor="#D4DCE3"
                android:angle="270" />
        </shape>
    </item>
    <!-- 微妙的图案层：半透明的几何圆点 -->
    <item>
        <bitmap
            android:src="@drawable/bg_chat_pattern"
            android:tileMode="repeat"
            android:alpha="0.3" />
    </item>
</layer-list>
