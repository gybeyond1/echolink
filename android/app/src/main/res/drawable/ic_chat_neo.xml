                android:startY="3"
                android:endX="19"
                android:endY="19"
                android:type="linear">
                <item android:offset="0" android:color="#F5F5F5" />
                <item android:offset="0.5" android:color="#E8E8E8" />
                <item android:offset="1" android:color="#D8D8D8" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 高光层（左上偏移） -->
    <path
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.5"
        android:pathData="M5,3h14c1.1,0 2,0.9 2,2v2c0,-1.1 -0.9,-2 -2,-2H5c-1.1,0 -2,0.9 -2,2V5c0,-1.1 0.9,-2 2,-2z" />
