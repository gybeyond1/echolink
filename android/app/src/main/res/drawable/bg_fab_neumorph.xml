<?xml version="1.0" encoding="utf-8"?>
<!-- 右下角悬浮按钮：新拟态凸起圆形（亮色/暗色随主题自动切换） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 右下暗影 -->
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_dark" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- 左上高光 -->
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_shadow_light" />
            <corners android:radius="26dp" />
        </shape>
    </item>
    <!-- 表面 -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="rectangle">
            <solid android:color="@color/neu_base" />
            <corners android:radius="26dp" />
        </shape>
    </item>
</layer-list>
