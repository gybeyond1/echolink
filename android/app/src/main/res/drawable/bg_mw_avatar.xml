<?xml version="1.0" encoding="utf-8"?>
<!-- 留言板头像底：灰色新拟态圆形（与 WebUI .mw-avatar 一致） -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- 右下暗影 -->
    <item android:left="2dp" android:top="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_shadow_dark" />
        </shape>
    </item>
    <!-- 左上高光 -->
    <item android:right="2dp" android:bottom="2dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_shadow_light" />
        </shape>
    </item>
    <!-- 表面 -->
    <item android:left="1dp" android:top="1dp" android:right="1dp" android:bottom="1dp">
        <shape android:shape="oval">
            <solid android:color="@color/neu_base" />
        </shape>
    </item>
</layer-list>
