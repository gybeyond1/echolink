<?xml version="1.0" encoding="utf-8"?>
<!-- 新拟态风格主题切换图标（太阳，更宽更饱满） -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="24dp"
    android:height="24dp"
    android:viewportWidth="24"
    android:viewportHeight="24">
    <!-- 太阳中心圆 -->
    <path
        android:pathData="M12,7m-4,0a4,4 0,1 1,8 0a4,4 0,1 1,-8 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:startX="4"
                android:startY="4"
                android:endX="20"
                android:endY="20"
                android:type="linear">
                <item android:offset="0" android:color="#909090" />
                <item android:offset="1" android:color="#707070" />
            </gradient>
        </aapt:attr>
    </path>
    <!-- 太阳光芒（8个方向，更粗更宽） -->
    <path
        android:pathData="M12,2L12,4.5M12,19.5L12,22M2,12L4.5,12M19.5,12L22,12M4.93,4.93L6.7,6.7M17.3,17.3L19.07,19.07M4.93,19.07L6.7,17.3M17.3,6.7L19.07,4.93"
        android:strokeWidth="2"
        android:strokeLineCap="round">
        <aapt:attr name="android:strokeColor">
            <gradient
                android:startX="2"
                android:startY="2"
                android:endX="22"
                android:endY="22"
                android:type="linear">
                <item android:offset="0" android:color="#909090" />
                <item android:offset="1" android:color="#707070" />
            </gradient>
        </aapt:attr>
    </path>
</vector>
