<?xml version="1.0" encoding="utf-8"?>
<!-- Telegram-style chat message: avatar on left, content on right.
     Consecutive messages from same sender: avatar INVISIBLE, sender row GONE. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="4dp"
    android:paddingBottom="2dp">

    <!-- Avatar (36dp circle): emoji/text fallback or network image -->
    <FrameLayout
        android:id="@+id/avatarContainer"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginStart="0dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="2dp">

        <TextView
            android:id="@+id/tvAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:textSize="17sp"
            android:textColor="@android:color/white"
            android:background="@drawable/bg_circle_avatar" />

        <ImageView
            android:id="@+id/ivAvatar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_default_avatar"
            android:background="@drawable/bg_circle_avatar"
            android:clipToOutline="true"
            android:outlineProvider="background"
            android:visibility="gone" />
    </FrameLayout>

    <!-- Content area (no background - sender info sits above the bubble) -->
    <LinearLayout
        android:id="@+id/llContent"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Sender + time row (GONE for consecutive messages) - ABOVE bubble -->
        <LinearLayout
            android:id="@+id/llSenderInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginBottom="2dp">

            <TextView
                android:id="@+id/tvSender"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/brand_primary"
                android:textSize="13sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="11sp" />
        </LinearLayout>

        <!-- Actual bubble (background + padding here) -->
        <LinearLayout
            android:id="@+id/bubbleInner"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:background="@drawable/bg_neumorph"
            android:padding="8dp">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textSize="14sp" />

            <!-- Media area (image / video thumbnail, default hidden) -->
            <FrameLayout
                android:id="@+id/mediaContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivMedia"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:scaleType="centerCrop" />

                <ImageView
                    android:id="@+id/ivPlayOverlay"
                    android:layout_width="44dp"
                    android:layout_height="44dp"
                    android:layout_gravity="center"
                    android:src="@android:drawable/ic_media_play"
                    android:background="@drawable/bg_circle_avatar"
                    android:padding="9dp"
                    android:visibility="gone" />
            </FrameLayout>

            <LinearLayout
                android:id="@+id/llVoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/ivVoiceIcon"
                    android:layout_width="22dp"
                    android:layout_height="22dp"
                    android:src="@drawable/ic_voice_3"
                    android:scaleType="centerInside" />

                <!-- 弹性占位：把播放标志和时长分到两端 -->
                <View
                    android:layout_width="0dp"
                    android:layout_height="1dp"
                    android:layout_weight="1" />

                <TextView
                    android:id="@+id/tvVoiceDuration"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0&quot;"
                    android:textColor="@color/on_surface"
                    android:textSize="15sp" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/llFile"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_role_badge"
                android:padding="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tvFile"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="📄 文件"
                    android:textColor="@android:color/white"
                    android:textSize="14sp" />
            </LinearLayout>

        </LinearLayout>
    </LinearLayout>

    <!-- 已读回执 + 发送中圈圈：放在气泡外侧 -->
    <FrameLayout
        android:id="@+id/statusContainer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:layout_marginStart="4dp"
        android:layout_marginEnd="4dp"
        android:layout_marginBottom="6dp">

        <ImageView
            android:id="@+id/ivStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/pbSending"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:indeterminateTint="@color/on_surface_variant"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
