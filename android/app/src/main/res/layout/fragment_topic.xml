<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@android:color/transparent">

    <!-- 顶部栏（列表态 / 聊天态 切换可见性）；背景透明，让整页壁纸（含顶栏）成为统一整体 -->
    <LinearLayout
        android:id="@+id/topBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        android:orientation="horizontal"
        android:background="@android:color/transparent"
        android:gravity="center_vertical">

        <!-- 列表态 -->
        <TextView
            android:id="@+id/tvTitleList"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:text="消息"
            android:visibility="gone"
            android:gravity="center"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_wallpaper" />

        <!-- 设置入口（列表态显示，替代底栏设置 tab） -->
        <ImageButton
            android:id="@+id/btnSettings"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="设置"
            android:padding="10dp"
            android:scaleType="centerInside"
            android:src="@drawable/ic_settings"
            android:visibility="gone" />

        <!-- 聊天态（返回交给系统返回手势/按键，不再显示返回按钮） -->
        <TextView
            android:id="@+id/tvChatTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_gravity="center_vertical"
            android:gravity="center"
            android:text=""
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/on_wallpaper"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPending"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="待审批"
            android:textColor="@color/on_primary"
            android:visibility="gone"
            style="@style/Widget.MaterialComponents.Button.TextButton" />

        <!-- 多选操作栏：聊天多选时显示在顶部栏右侧，与对方昵称垂直齐平，不占消息流 -->
        <LinearLayout
            android:id="@+id/selectionBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginStart="8dp"
            android:padding="4dp"
            android:gravity="center_vertical|end"
            android:visibility="gone">

            <ImageButton
                android:id="@+id/btnSelectAll"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="全选"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_select_all" />

            <ImageButton
                android:id="@+id/btnDeleteSel"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginEnd="4dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="删除"
                android:padding="10dp"
                android:scaleType="centerInside"
                android:src="@drawable/ic_delete" />
        </LinearLayout>

    </LinearLayout>

    <!-- 双栏容器：手机=列表/聊天全屏切换；平板(≥600dp)=左列表右聊天并排 -->
    <LinearLayout
        android:id="@+id/dualPane"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <!-- 列表态：话题会话列表 -->
        <LinearLayout
            android:id="@+id/listLayout"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

        <!-- 通知（置顶会话条，点进去看通知详情；新拟态凸起卡片，与下方会话列表风格一致） -->
        <LinearLayout
            android:id="@+id/rowNotifications"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_neumorph"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="🔔"
                    android:textSize="20sp"
                    android:background="@drawable/bg_notif_avatar" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="通知"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:text="所有设备的同步通知"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textColor="@color/on_surface_variant" />
        </LinearLayout>

        <!-- 新的申请（好友申请 + 加群申请，置顶入口；新拟态凸起卡片，与下方会话列表风格一致） -->
        <LinearLayout
            android:id="@+id/rowNewRequests"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_neumorph"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="👥"
                    android:textSize="19sp"
                    android:background="@drawable/bg_req_avatar"
                    android:contentDescription="新的申请" />
            </FrameLayout>

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="新的申请"
                    android:textSize="16sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvReqPreview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textSize="13sp"
                    android:textColor="@color/on_surface_variant"
                    android:maxLines="1"
                    android:ellipsize="end" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvReqBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:layout_marginStart="8dp"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_pending_badge" />
        </LinearLayout>

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeListRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvTopics"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <TextView
                android:id="@+id/tvEmptyTopics"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="还没有话题\n到「好友」页点「+」发现或新建话题"
                android:gravity="center"
                android:padding="48dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- 悬浮加号：新建 / 发现话题（与好友页 FAB 对齐） -->
            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/fabAddTopic"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end|bottom"
                android:layout_margin="16dp"
                android:contentDescription="新建话题"
                android:src="@android:drawable/ic_input_add"
                app:backgroundTint="@color/brand_primary"
                app:tint="@color/white"
                app:elevation="6dp" />
        </FrameLayout>
    </LinearLayout>

    <!-- 聊天态 -->
    <LinearLayout
        android:id="@+id/chatLayout"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <!-- 消息区：列表与「空态」叠加，空态不会挤压底部输入栏 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recyclerView"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <TextView
                android:id="@+id/tvEmptyChat"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:text="暂无消息\n发送一条消息开始聊天"
                android:gravity="center"
                android:padding="48dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="16sp"
                android:visibility="gone" />

            <!-- 未读消息气泡（微信式小红点升级版）：聊天中收到新消息且用户已向上翻看时显示，
                 点击跳到最新；滚到底自动隐藏 -->
            <LinearLayout
                android:id="@+id/unreadPill"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal|bottom"
                android:layout_marginBottom="14dp"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:background="@drawable/bg_unread_pill"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:paddingTop="6dp"
                android:paddingBottom="6dp"
                android:elevation="4dp"
                android:clickable="true"
                android:focusable="true"
                android:visibility="gone">

                <ImageView
                    android:layout_width="16dp"
                    android:layout_height="16dp"
                    android:src="@drawable/ic_arrow_down"
                    android:scaleType="centerInside" />

                <TextView
                    android:id="@+id/tvUnreadCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:textColor="@color/on_primary"
                    android:textSize="13sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <!-- 多选操作栏已移至顶部栏 topBar 右侧（见 selectionBar） -->
        </FrameLayout>

        <!-- 底部输入栏（微信式）：背景透明，让全局壁纸（含输入框区域）整页覆盖 -->
        <LinearLayout
            android:id="@+id/inputBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:background="@android:color/transparent"
            android:paddingStart="6dp"
            android:paddingEnd="6dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:gravity="center_vertical">

            <ImageButton
                android:id="@+id/btnVoiceToggle"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:src="@drawable/ic_mic"
                android:contentDescription="语音/键盘切换" />

            <FrameLayout
                android:layout_width="0dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_weight="1"
                android:layout_marginStart="6dp"
                android:layout_marginEnd="6dp">

                <EditText
                    android:id="@+id/etInput"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:paddingStart="12dp"
                    android:paddingEnd="12dp"
                    android:hint="说点什么..."
                    android:textSize="15sp"
                    android:maxLines="4"
                    android:inputType="textMultiLine"
                    android:imeOptions="actionSend" />

                <Button
                    android:id="@+id/btnHoldTalk"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@drawable/bg_input"
                    android:text="按住 说话"
                    android:textSize="15sp"
                    android:textColor="?android:attr/textColorPrimary"
                    android:visibility="gone" />
            </FrameLayout>

            <ImageButton
                android:id="@+id/btnEmoji"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:src="@drawable/ic_emoji"
                android:contentDescription="表情" />

            <ImageButton
                android:id="@+id/btnPlus"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="2dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:scaleType="centerInside"
                android:src="@drawable/ic_attachment"
                android:contentDescription="附件" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_gravity="center_vertical"
                android:layout_marginStart="4dp"
                android:backgroundTint="@color/brand_primary"
                android:text="发送"
                android:textColor="?attr/colorOnPrimary"
                android:textSize="14sp"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 表情 / 更多 面板 -->
        <FrameLayout
            android:id="@+id/panelContainer"
            android:layout_width="match_parent"
            android:layout_height="220dp"
            android:background="@android:color/transparent"
            android:visibility="gone">

            <GridView
                android:id="@+id/emojiGrid"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:numColumns="7"
                android:verticalSpacing="10dp"
                android:horizontalSpacing="6dp"
                android:padding="12dp"
                android:gravity="center"
                android:stretchMode="columnWidth"
                android:visibility="visible" />

        </FrameLayout>
    </LinearLayout>

    </LinearLayout><!-- dualPane -->

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone" />

</LinearLayout>
