<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@android:color/transparent">

    <!-- 左侧：好友列表（手机=整页；平板=固定宽度的左栏，右侧放聊天） -->
    <LinearLayout
        android:id="@+id/leftPane"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:background="@android:color/transparent">

        <!-- 顶部栏；背景透明，让整页壁纸（含顶栏）成为统一整体 -->
        <LinearLayout
            android:id="@+id/topBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="?attr/actionBarSize"
            android:orientation="horizontal"
            android:background="@android:color/transparent"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/tvTitle"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_gravity="center_vertical"
                android:text="通讯录"
                android:gravity="center"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/on_wallpaper" />

        </LinearLayout>

        <!-- 新的朋友（好友申请入口，带红点）；新拟态凸起卡片，与下方好友列表风格一致 -->
        <LinearLayout
            android:id="@+id/rowNewFriends"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="10dp"
            android:paddingBottom="10dp"
            android:background="@drawable/bg_neumorph"
            android:foreground="?attr/selectableItemBackgroundBorderless"
            android:layout_marginStart="10dp"
            android:layout_marginEnd="10dp"
            android:layout_marginTop="6dp"
            android:layout_marginBottom="2dp">

            <FrameLayout
                android:layout_width="44dp"
                android:layout_height="44dp">

                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="11dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_new_friends"
                    android:background="@drawable/bg_circle_avatar"
                    android:contentDescription="新的朋友" />
            </FrameLayout>

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="12dp"
                android:text="新的朋友"
                android:textSize="16sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvNewBadge"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:gravity="center"
                android:textSize="11sp"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_pending_badge"
                android:visibility="gone" />
        </LinearLayout>

        <!-- 好友列表 -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
                android:id="@+id/swipeFriendsRefresh"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvFriends"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="false"
                    android:paddingBottom="8dp" />
            </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

            <TextView
                android:id="@+id/tvEmptyFriends"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="还没有好友\n点右下角「+」添加好友或发现话题"
                android:gravity="center"
                android:padding="48dp"
                android:textColor="@color/on_surface_variant"
                android:textSize="16sp"
                android:visibility="gone" />
        </FrameLayout>

        <!-- 底部大「+」：添加好友 / 发现·创建话题（原消息页 FAB + 右上角添加，合并入口） -->
        <com.google.android.material.floatingactionbutton.FloatingActionButton
            android:id="@+id/fabAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_margin="16dp"
            android:contentDescription="添加"
            android:src="@android:drawable/ic_input_add"
            app:backgroundTint="@color/brand_primary"
            app:tint="@color/white"
            app:elevation="6dp" />
    </LinearLayout>

    <!-- 右侧：平板聊天容器（手机隐藏；点好友后在右侧打开聊天，左栏保留好友列表） -->
    <FrameLayout
        android:id="@+id/chatContainer"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:background="@android:color/transparent"
        android:visibility="gone">

        <TextView
            android:id="@+id/tvChatPlaceholder"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="选择一个好友开始聊天"
            android:textSize="16sp"
            android:textColor="@color/on_surface_variant"
            android:visibility="visible" />
    </FrameLayout>

</LinearLayout>
