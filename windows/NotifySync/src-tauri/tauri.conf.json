{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "EchoLink",
  "version": "0.1.0",
  "identifier": "com.gybeyond.notifysync",
  "build": {
    "beforeDevCommand": "",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [
      {
        "label": "host",
        "url": "index.html",
        "title": "EchoLink",
        "width": 1,
        "height": 1,
        "visible": false,
        "skipTaskbar": true,
        "decorations": false,
        "resizable": false,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "languages": ["SimpChinese"],
        "displayLanguageSelector": false
      }
    }
  }
}
