// EchoLink Desktop —— Slint 原生界面（对齐 Android / WebUI 逻辑，原生控件，无网页）

import { Button, LineEdit, ScrollView, Switch, CheckBox, TextEdit } from "std-widgets.slint";

// ---- Telegram Day 配色 ----
global Colors {
    out property <color> primary: #3390EC;
    out property <color> primary-dark: #2B7CD3;
    out property <color> bubble-mine: #EFFDDE;
    out property <color> bubble-other: #FFFFFF;
    out property <color> time-mine: #6BAD6E;
    out property <color> chat-bg: #D6DDE4;
    out property <color> page-bg: #F0F2F5;
    out property <color> surface: #FFFFFF;
    out property <color> text-primary: #1A1A1A;
    out property <color> text-secondary: #707579;
    out property <color> text-hint: #A0A0A0;
    out property <color> divider: #E7E7E7;
    out property <color> hover: #F5F7FA;
    out property <color> selected: #E7F0FF;
    out property <color> danger: #E74C3C;
    out property <color> badge: #E74C3C;
    out property <color> avatar-start: #2AABEE;
    out property <color> avatar-end: #229ED9;
}

export struct TopicItem {
    name: string,
    display: string,
    kind: string,
    avatar: string,
    avatar-letter: string,
    preview: string,
    count: int,
    unread: int,
    time: string,
}

export struct MsgItem {
    id: int,
    text: string,
    mine: bool,
    sender: string,
    time: string,
    media: string,
}

export struct FriendItem {
    username: string,
    display: string,
}

export struct FilterItem {
    pkg: string,
    name: string,
    checked: bool,
}

export struct AppItem {
    name: string,
    exe: string,
    checked: bool,
}

export struct NotifItem {
    id: int,
    app: string,
    title: string,
    text: string,
    time: string,
}

export struct DeviceItem {
    name: string,
    platform: string,
    last: string,
}

// ---- 通用组件 ----

component PrimaryButton {
    in property <string> text: "";
    in property <bool> enabled: true;
    callback clicked();

    Rectangle {
        height: 40px;
        background: enabled ? Colors.primary : #A0C7F0;
        border-radius: 10px;
        HorizontalLayout {
            alignment: center;
            Text { text: root.text; font-size: 15px; font-weight: 600; color: white; }
        }
        touch := TouchArea { clicked => { if enabled { root.clicked(); } } }
        states [
            pressed when touch.pressed: { background: enabled ? Colors.primary-dark : #A0C7F0; }
            hover when touch.has-hover && enabled: { background: #2B8CEE; }
        ]
    }
}

component GhostButton {
    in property <string> text: "";
    callback clicked();

    Rectangle {
        height: 34px;
        background: transparent;
        border-radius: 8px;
        HorizontalLayout {
            alignment: center;
            Text { text: root.text; font-size: 13px; font-weight: 500; color: Colors.primary; }
        }
        touch := TouchArea { clicked => { root.clicked(); } }
        states [
            hover when touch.has-hover: { background: #EBF5FF; }
        ]
    }
}

component NavIcon {
    in property <string> name: "";
    in property <color> tint: Colors.text-hint;

    Rectangle {
        width: 24px;
        height: 24px;

        if name == "messages": Rectangle {
            width: 22px;
            height: 17px;
            border-radius: 6px;
            background: root.tint;
            y: (parent.height - self.height) / 2;
            x: (parent.width - self.width) / 2;
            Rectangle { y: 6px; x: 5px; width: 12px; height: 2px; background: white; border-radius: 1px; }
            Rectangle { y: 11px; x: 5px; width: 8px; height: 2px; background: white; border-radius: 1px; }
        }

        if name == "friends": Rectangle {
            width: 22px;
            height: 19px;
            y: (parent.height - self.height) / 2;
            x: (parent.width - self.width) / 2;
            Rectangle { width: 12px; height: 12px; border-radius: self.width / 2; background: root.tint; x: 0px; y: 0px; }
            Rectangle { width: 12px; height: 12px; border-radius: self.width / 2; background: root.tint; x: 10px; y: 7px; opacity: 0.85; }
        }

        if name == "notifications": Rectangle {
            width: 19px;
            height: 17px;
            border-radius: 7px;
            background: root.tint;
            y: (parent.height - self.height) / 2;
            x: (parent.width - self.width) / 2;
            Rectangle { y: -4px; x: (parent.width - self.width) / 2; width: 7px; height: 7px; border-radius: self.width / 2; background: root.tint; }
        }

        if name == "devices": Rectangle {
            width: 14px;
            height: 22px;
            border-radius: 4px;
            background: root.tint;
            y: (parent.height - self.height) / 2;
            x: (parent.width - self.width) / 2;
            Rectangle { y: 18px; x: (parent.width - self.width) / 2; width: 4px; height: 1px; background: white; border-radius: 0.5px; }
        }

        if name == "settings": Rectangle {
            width: 20px;
            height: 20px;
            border-radius: self.width / 2;
            background: root.tint;
            y: (parent.height - self.height) / 2;
            x: (parent.width - self.width) / 2;
            Rectangle { width: 8px; height: 8px; border-radius: self.width / 2; background: white; y: (parent.height - self.height) / 2; x: (parent.width - self.width) / 2; }
        }

        if name == "logout": Rectangle {
            width: 20px;
            height: 20px;
            border-radius: 4px;
            border-width: 2.5px;
            border-color: root.tint;
            y: (parent.height - self.height) / 2;
            x: (parent.width - self.width) / 2;
            Rectangle { width: 8px; height: 2.5px; background: root.tint; y: (parent.height - self.height) / 2; x: 7px; }
        }
    }
}

component NavButton {
    in property <string> icon: "";
    in property <bool> active: false;
    callback clicked();

    Rectangle {
        width: 48px;
        height: 48px;
        background: active ? #E3F0FF : transparent;
        border-radius: 12px;
        touch := TouchArea { clicked => { root.clicked(); } }
        states [
            hover when !active && touch.has-hover: { background: #F0F4F9; }
        ]
        NavIcon {
            name: root.icon;
            tint: active ? Colors.primary : #8A96A3;
            width: 24px;
            height: 24px;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

component Avatar {
    in property <string> label: "";

    Rectangle {
        width: 44px;
        height: 44px;
        border-radius: 22px;
        background: @linear-gradient(135deg, Colors.avatar-start, Colors.avatar-end);
        clip: true;
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                Text {
                    text: root.label;
                    color: white;
                    font-size: 15px;
                    font-weight: 600;
                    width: 34px;
                    overflow: elide;
                    horizontal-alignment: center;
                }
            }
        }
    }
}

component Badge {
    in property <int> count: 0;
    visible: count > 0;
    Rectangle {
        width: 18px;
        height: 18px;
        border-radius: self.width / 2;
        background: Colors.badge;
        HorizontalLayout {
            alignment: center;
            Text { text: count; color: white; font-size: 11px; font-weight: 600; }
        }
    }
}

component VDivider {
    Rectangle { width: 1px; background: Colors.divider; }
}

component HDivider {
    Rectangle { height: 1px; background: Colors.divider; }
}

// ---- 消息气泡 ----

component MessageBox {
    in-out property <string> text: "";
    in-out property <bool> mine: false;
    in-out property <string> sender: "";
    in-out property <string> time: "";
    in-out property <string> media: "";
    in-out property <int> msg-id: 0;
    callback delete(int);

    HorizontalLayout {
        padding: 4px;
        spacing: 4px;
        if mine: Rectangle { horizontal-stretch: 1; min-width: 0px; }
        Rectangle {
            background: mine ? Colors.bubble-mine : Colors.bubble-other;
            border-radius: 14px;
            drop-shadow-color: #00000015;
            drop-shadow-blur: 2px;
            drop-shadow-offset-y: 1px;
            padding-left: 11px;
            padding-right: 11px;
            padding-top: 9px;
            padding-bottom: 9px;
            min-width: 60px;
            max-width: 420px;
            VerticalLayout {
                spacing: 2px;
                if !mine: Text { text: sender; font-size: 12px; font-weight: 600; color: Colors.primary; }
                Text { text: text; font-size: 14px; color: Colors.text-primary; wrap: word-wrap; }
                if media != "": Text { text: media; font-size: 12px; color: Colors.primary; }
                HorizontalLayout {
                    alignment: end;
                    spacing: 6px;
                    Text { text: time; font-size: 11px; color: mine ? Colors.time-mine : #999999; }
                    TouchArea {
                        clicked => { delete(msg-id); }
                        Text { text: "x"; font-size: 11px; color: #CCCCCC; }
                    }
                }
            }
        }
        if !mine: Rectangle { horizontal-stretch: 1; min-width: 0px; }
    }
}

component TopicRow {
    in property <TopicItem> topic;
    in property <bool> selected: false;
    callback clicked();

    Rectangle {
        height: 68px;
        background: selected ? Colors.selected : Colors.surface;
        touch := TouchArea { clicked => { root.clicked(); } }
        states [
            hover when !selected && touch.has-hover: { background: Colors.hover; }
        ]
        HorizontalLayout {
            padding-left: 14px;
            padding-right: 14px;
            padding-top: 10px;
            padding-bottom: 10px;
            spacing: 12px;
            alignment: center;
            Avatar {
                label: topic.avatar-letter;
                width: 48px;
                height: 48px;
            }
            VerticalLayout {
                spacing: 4px;
                horizontal-stretch: 1;
                alignment: center;
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    Text { text: (topic.kind == "normal" ? "# " : "") + topic.display; font-size: 14px; font-weight: 600; color: Colors.text-primary; horizontal-stretch: 1; overflow: elide; }
                    Text { text: topic.time; font-size: 11px; color: Colors.text-hint; }
                }
                HorizontalLayout {
                    spacing: 6px;
                    alignment: center;
                    Text { text: topic.preview; font-size: 12px; color: topic.unread > 0 ? Colors.text-primary : Colors.text-secondary; font-weight: topic.unread > 0 ? 600 : 400; horizontal-stretch: 1; overflow: elide; }
                    Badge { count: topic.unread; }
                }
            }
        }
    }
}

component SectionCard {
    in property <string> title: "";
    VerticalLayout {
        spacing: 10px;
        padding-left: 16px;
        padding-right: 16px;
        padding-top: 16px;
        padding-bottom: 16px;
        Rectangle {
            background: Colors.surface;
            border-radius: 12px;
            drop-shadow-color: #00000008;
            drop-shadow-blur: 3px;
            drop-shadow-offset-y: 1px;
            VerticalLayout {
                padding-left: 16px;
                padding-right: 16px;
                padding-top: 14px;
                padding-bottom: 14px;
                spacing: 12px;
                if root.title != "": Text { text: root.title; font-size: 13px; font-weight: 600; color: Colors.text-secondary; }
                @children
            }
        }
    }
}

component InputLine {
    in property <string> label: "";
    in-out property <string> text;
    in property <string> placeholder: "";
    VerticalLayout {
        spacing: 4px;
        if root.label != "": Text { text: root.label; font-size: 12px; font-weight: 600; color: Colors.text-secondary; }
        Rectangle {
            background: Colors.page-bg;
            border-radius: 10px;
            height: 42px;
            padding-left: 12px;
            padding-right: 12px;
            HorizontalLayout {
                LineEdit { text <=> root.text; placeholder-text: root.placeholder; font-size: 14px; width: 100%; height: 100%; }
            }
        }
    }
}

component PasswordLine {
    in property <string> label: "";
    in-out property <string> text;
    in property <string> placeholder: "";
    VerticalLayout {
        spacing: 4px;
        if root.label != "": Text { text: root.label; font-size: 12px; font-weight: 600; color: Colors.text-secondary; }
        Rectangle {
            background: Colors.page-bg;
            border-radius: 10px;
            height: 42px;
            padding-left: 12px;
            padding-right: 12px;
            HorizontalLayout {
                LineEdit { text <=> root.text; placeholder-text: root.placeholder; input-type: password; font-size: 14px; width: 100%; height: 100%; }
            }
        }
    }
}

component MainWindow inherits Window {
    title: "EchoLink";
    width: 1040px;
    height: 680px;
    background: Colors.page-bg;

    // ---- callbacks invoked from Rust ----
    callback do-login(string, string, string);
    callback do-register(string, string, string);
    callback load-topics();
    callback open-topic(string);
    callback send-message(string);
    callback delete-msg(int);
    callback delete-msg-topic(int, string);
    callback switch-tab(string);
    callback load-friends();
    callback friend-chat(string);
    callback add-friend(string);
    callback load-notifications();
    callback load-devices();
    callback load-filters();
    callback toggle-sync(bool);
    callback save-filter(string, bool);
    callback del-filter(string);
    callback save-nickname(string);
    callback change-pass(string, string);
    callback do-logout();
    callback refresh-apps();

    // ---- state properties (Rust pushes data in) ----
    in-out property <bool> logged-in: false;
    in-out property <string> server-url: "";
    in-out property <string> username: "";
    in-out property <string> display-name: "";
    in-out property <string> current-tab: "messages";
    in-out property <string> chat-title: "";
    in-out property <string> chat-sub: "";
    in-out property <string> current-topic: "";
    in-out property <bool> chat-open: false;
    in-out property <[TopicItem]> topics: [];
    in-out property <[MsgItem]> messages: [];
    in-out property <[FriendItem]> friends: [];
    in-out property <[FilterItem]> filters: [];
    in-out property <[AppItem]> apps: [];
    in-out property <[NotifItem]> notifs: [];
    in-out property <[DeviceItem]> devices: [];
    in-out property <string> status: "";
    in-out property <bool> sync-enabled: false;
    in-out property <string> input-text: "";
    in-out property <string> login-user: "";
    in-out property <string> login-pass: "";
    in-out property <bool> reg-mode: false;
    in-out property <string> friend-query: "";
    in-out property <string> settings-url: "";
    in-out property <string> nickname: "";
    in-out property <string> old-pass: "";
    in-out property <string> new-pass: "";

    // ---- 登录页 ----
    if !logged-in: Rectangle {
        background: @linear-gradient(145deg, Colors.primary, #4FA3F7);
        HorizontalLayout {
            alignment: center;
            VerticalLayout {
                alignment: center;
                Rectangle {
                    background: Colors.surface;
                    border-radius: 20px;
                    drop-shadow-color: #00000025;
                    drop-shadow-blur: 28px;
                    drop-shadow-offset-y: 8px;
                    width: 360px;
                    padding-left: 36px;
                    padding-right: 36px;
                    padding-top: 36px;
                    padding-bottom: 36px;
                    VerticalLayout {
                        spacing: 16px;
                        HorizontalLayout {
                            alignment: center;
                            Rectangle {
                                width: 64px;
                                height: 64px;
                                border-radius: 18px;
                                background: @linear-gradient(135deg, Colors.avatar-start, Colors.avatar-end);
                                HorizontalLayout {
                                    alignment: center;
                                    Text { text: "E"; color: white; font-size: 28px; font-weight: 700; }
                                }
                            }
                        }
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "EchoLink"; font-size: 24px; font-weight: 700; color: Colors.text-primary; horizontal-alignment: center; }
                            Text { text: "跨设备消息互联 · 通知同步"; font-size: 13px; color: Colors.text-secondary; horizontal-alignment: center; }
                        }
                        InputLine { label: "服务器地址"; text <=> server-url; placeholder: "https://你的服务器"; }
                        InputLine { label: "用户名"; text <=> login-user; placeholder: "3-32 个字符"; }
                        PasswordLine { label: "密码"; text <=> login-pass; placeholder: "至少 6 位"; }
                        PrimaryButton {
                            text: reg-mode ? "注册并进入" : "登录";
                            clicked => {
                                if reg-mode { do-register(server-url, login-user, login-pass); }
                                else { do-login(server-url, login-user, login-pass); }
                            }
                        }
                        GhostButton {
                            text: reg-mode ? "已有账号？去登录" : "还没有账号？注册一个";
                            clicked => { reg-mode = !reg-mode; }
                        }
                        if status != "": Text { text: status; color: Colors.danger; font-size: 12px; horizontal-alignment: center; wrap: word-wrap; }
                    }
                }
            }
        }
    }

    // ---- 主界面 ----
    if logged-in: HorizontalLayout {
        // 左侧图标导航条（紧凑，参考 Telegram/微信桌面版）
        Rectangle {
            background: Colors.surface;
            width: 64px;
            VerticalLayout {
                padding-top: 14px;
                padding-bottom: 14px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                alignment: start;
                Rectangle {
                    width: 48px;
                    height: 48px;
                    background: @linear-gradient(135deg, Colors.avatar-start, Colors.avatar-end);
                    border-radius: 14px;
                    HorizontalLayout {
                        alignment: center;
                        Text { text: "E"; color: white; font-size: 22px; font-weight: 700; }
                    }
                }
                Rectangle { height: 12px; }
                NavButton { icon: "messages"; active: current-tab == "messages"; clicked => { switch-tab("messages"); } }
                NavButton { icon: "friends"; active: current-tab == "friends"; clicked => { switch-tab("friends"); } }
                NavButton { icon: "notifications"; active: current-tab == "notifications"; clicked => { switch-tab("notifications"); } }
                NavButton { icon: "devices"; active: current-tab == "devices"; clicked => { switch-tab("devices"); } }
                NavButton { icon: "settings"; active: current-tab == "settings"; clicked => { switch-tab("settings"); } }
                Rectangle { vertical-stretch: 1; }
                NavButton { icon: "logout"; active: false; clicked => { do-logout(); } }
            }
            VDivider { x: parent.width - self.width; height: 100%; }
        }

        // 主区
        Rectangle {
            background: Colors.page-bg;
            if current-tab == "messages": HorizontalLayout {
                // 会话列表
                Rectangle {
                    background: Colors.surface;
                    width: 280px;
                    VerticalLayout {
                        Rectangle {
                            height: 60px;
                            background: Colors.surface;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: center;
                                Text { text: "消息"; font-size: 18px; font-weight: 700; color: Colors.text-primary; }
                            }
                            HDivider { y: parent.height - self.height; width: 100%; }
                        }
                        ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                alignment: start;
                                spacing: 0px;
                                for t in topics: TopicRow {
                                    topic: t;
                                    selected: chat-open && chat-title == t.display;
                                    clicked => { open-topic(t.name); }
                                }
                            }
                        }
                    }
                    VDivider { x: parent.width - self.width; height: 100%; }
                }
                // 聊天区
                Rectangle {
                    background: Colors.chat-bg;
                    horizontal-stretch: 1;
                    VerticalLayout {
                        if chat-open: Rectangle {
                            height: 60px;
                            background: Colors.surface;
                            HorizontalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                alignment: center;
                                spacing: 10px;
                                Avatar { label: chat-title; width: 40px; height: 40px; }
                                VerticalLayout {
                                    spacing: 1px;
                                    alignment: center;
                                    horizontal-stretch: 1;
                                    Text { text: chat-title; font-size: 15px; font-weight: 700; color: Colors.text-primary; }
                                    Text { text: chat-sub; font-size: 12px; color: Colors.text-secondary; }
                                }
                            }
                            HDivider { y: parent.height - self.height; width: 100%; }
                        }
                        if chat-open: ScrollView {
                            vertical-stretch: 1;
                            VerticalLayout {
                                padding-left: 18px;
                                padding-right: 18px;
                                padding-top: 14px;
                                padding-bottom: 14px;
                                spacing: 6px;
                                for m in messages: MessageBox {
                                    text: m.text;
                                    mine: m.mine;
                                    sender: m.sender;
                                    time: m.time;
                                    media: m.media;
                                    msg-id: m.id;
                                    delete(msg-id) => { delete-msg-topic(msg-id, current-topic); }
                                }
                            }
                        }
                        if chat-open: Rectangle {
                            height: 68px;
                            background: Colors.surface;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                padding-top: 12px;
                                padding-bottom: 12px;
                                spacing: 12px;
                                alignment: center;
                                Rectangle {
                                    horizontal-stretch: 1;
                                    background: Colors.page-bg;
                                    border-radius: 22px;
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    height: 44px;
                                    HorizontalLayout {
                                        TextEdit { text <=> input-text; placeholder-text: "输入消息…"; font-size: 14px; height: 100%; width: 100%; }
                                    }
                                }
                                PrimaryButton { text: "发送"; clicked => { send-message(input-text); } }
                            }
                            HDivider { y: 0px; width: 100%; }
                        }
                        if !chat-open: Rectangle {
                            vertical-stretch: 1;
                            background: Colors.chat-bg;
                            HorizontalLayout {
                                alignment: center;
                                VerticalLayout {
                                    alignment: center;
                                    spacing: 16px;
                                    Rectangle {
                                        width: 72px;
                                        height: 72px;
                                        border-radius: 24px;
                                        background: @linear-gradient(135deg, Colors.avatar-start, Colors.avatar-end);
                                        HorizontalLayout {
                                            alignment: center;
                                            Text { text: "E"; color: white; font-size: 32px; font-weight: 700; }
                                        }
                                    }
                                    VerticalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        Text { text: "EchoLink"; color: Colors.text-primary; font-size: 18px; font-weight: 600; }
                                        Text { text: "选择一个会话开始聊天"; color: Colors.text-hint; font-size: 14px; }
                                        Text { text: "消息会在所有登录设备间同步"; color: Colors.text-secondary; font-size: 12px; }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            if current-tab == "friends": ScrollView {
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 18px;
                    Text { text: "好友"; font-size: 18px; font-weight: 700; color: Colors.text-primary; }
                    Rectangle {
                        background: Colors.surface;
                        border-radius: 12px;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 16px;
                        padding-bottom: 16px;
                        HorizontalLayout {
                            spacing: 10px;
                            Rectangle {
                                horizontal-stretch: 1;
                                background: Colors.page-bg;
                                border-radius: 10px;
                                height: 40px;
                                padding-left: 12px;
                                padding-right: 12px;
                                HorizontalLayout {
                                    LineEdit { text <=> friend-query; placeholder-text: "输入对方用户名"; font-size: 14px; width: 100%; height: 100%; }
                                }
                            }
                            PrimaryButton { text: "加好友"; clicked => { add-friend(friend-query); } }
                        }
                    }
                    for f in friends: Rectangle {
                        height: 60px;
                        background: Colors.surface;
                        border-radius: 12px;
                        drop-shadow-color: #00000008;
                        drop-shadow-blur: 3px;
                        drop-shadow-offset-y: 1px;
                        HorizontalLayout {
                            padding-left: 14px;
                            padding-right: 14px;
                            padding-top: 10px;
                            padding-bottom: 10px;
                            spacing: 12px;
                            Avatar { label: f.display; }
                            Text { text: f.display; font-size: 15px; font-weight: 600; color: Colors.text-primary; horizontal-stretch: 1; y: (parent.height - self.height) / 2; }
                            PrimaryButton { text: "私聊"; clicked => { friend-chat(f.username); } }
                        }
                    }
                }
            }

            if current-tab == "notifications": ScrollView {
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 12px;
                    Text { text: "通知同步"; font-size: 18px; font-weight: 700; color: Colors.text-primary; }
                    Text { text: "来自其他设备的同步通知"; font-size: 13px; color: Colors.text-secondary; }
                    for n in notifs: Rectangle {
                        background: Colors.surface;
                        border-radius: 12px;
                        drop-shadow-color: #00000008;
                        drop-shadow-blur: 3px;
                        drop-shadow-offset-y: 1px;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        VerticalLayout {
                            spacing: 4px;
                            HorizontalLayout {
                                spacing: 8px;
                                Text { text: n.app; font-size: 13px; font-weight: 600; color: Colors.primary; horizontal-stretch: 1; }
                                Text { text: n.time; font-size: 11px; color: Colors.text-hint; }
                            }
                            Text { text: n.title; font-size: 14px; font-weight: 600; color: Colors.text-primary; }
                            if n.text != "": Text { text: n.text; font-size: 13px; color: Colors.text-secondary; wrap: word-wrap; }
                        }
                    }
                }
            }

            if current-tab == "devices": ScrollView {
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 12px;
                    Text { text: "已登录设备"; font-size: 18px; font-weight: 700; color: Colors.text-primary; }
                    for d in devices: Rectangle {
                        background: Colors.surface;
                        border-radius: 12px;
                        drop-shadow-color: #00000008;
                        drop-shadow-blur: 3px;
                        drop-shadow-offset-y: 1px;
                        padding-left: 16px;
                        padding-right: 16px;
                        padding-top: 14px;
                        padding-bottom: 14px;
                        HorizontalLayout {
                            spacing: 12px;
                            Avatar { label: d.platform; }
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                y: (parent.height - self.height) / 2;
                                Text { text: d.name; font-size: 14px; font-weight: 600; color: Colors.text-primary; }
                                Text { text: d.platform; font-size: 12px; color: Colors.text-secondary; }
                            }
                            Text { text: d.last; font-size: 11px; color: Colors.text-hint; y: (parent.height - self.height) / 2; }
                        }
                    }
                }
            }

            if current-tab == "settings": ScrollView {
                VerticalLayout {
                    padding-left: 24px;
                    padding-right: 24px;
                    padding-top: 24px;
                    padding-bottom: 24px;
                    spacing: 18px;
                    Text { text: "设置"; font-size: 18px; font-weight: 700; color: Colors.text-primary; }

                    SectionCard {
                        title: "服务器";
                        InputLine { text <=> server-url; }
                    }

                    SectionCard {
                        title: "通知同步";
                        VerticalLayout {
                            spacing: 6px;
                            HorizontalLayout {
                                spacing: 10px;
                                Text { text: "读取本机 Windows 通知并广播到其他设备"; font-size: 13px; color: Colors.text-primary; horizontal-stretch: 1; wrap: word-wrap; }
                                Switch { checked <=> sync-enabled; toggled => { toggle-sync(sync-enabled); } }
                            }
                            Text { text: "开启后，本机收到的通知会同步到手机等其它设备。"; font-size: 12px; color: Colors.text-secondary; }
                        }
                    }

                    SectionCard {
                        title: "应用过滤";
                        VerticalLayout {
                            spacing: 10px;
                            Text { text: "仅勾选的应用通知会被同步"; font-size: 13px; color: Colors.text-secondary; }
                            GhostButton { text: "刷新本机应用列表"; clicked => { refresh-apps(); } }
                            Rectangle {
                                height: 220px;
                                background: Colors.page-bg;
                                border-radius: 10px;
                                padding-left: 8px;
                                padding-right: 8px;
                                padding-top: 8px;
                                padding-bottom: 8px;
                                ScrollView {
                                    VerticalLayout {
                                        spacing: 2px;
                                        for a in apps: Rectangle {
                                            height: 36px;
                                            background: Colors.surface;
                                            border-radius: 8px;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                CheckBox {
                                                    text: a.name + (a.exe != "" ? "  (" + a.exe + ")" : "");
                                                    checked: a.checked;
                                                    toggled => { save-filter(a.exe, a.checked); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    SectionCard {
                        title: "个人资料";
                        VerticalLayout {
                            spacing: 10px;
                            InputLine { label: "昵称"; text <=> nickname; }
                            PrimaryButton { text: "保存昵称"; clicked => { save-nickname(nickname); } }
                        }
                    }

                    SectionCard {
                        title: "修改密码";
                        VerticalLayout {
                            spacing: 10px;
                            PasswordLine { placeholder: "当前密码"; text <=> old-pass; }
                            PasswordLine { placeholder: "新密码（≥6位）"; text <=> new-pass; }
                            PrimaryButton { text: "修改密码"; clicked => { change-pass(old-pass, new-pass); } }
                        }
                    }

                    if status != "": Text { text: status; color: Colors.danger; font-size: 12px; wrap: word-wrap; }
                }
            }
        }
    }
}

export { MainWindow }
